# Created automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=

# Optional for local Blob access. Vercel deployments use automatic OIDC credentials.
BLOB_READ_WRITE_TOKEN=

# Primary owner. Additional role-based users are managed inside Corner Ops.
APP_EMAIL=crfrary@gmail.com
APP_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public base URL used in employee schedule, message, and attendance emails.
APP_URL=

# Resend Inbound receives trusted Rezku report emails.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REZKU_ALLOWED_SENDER=support@rezku.com

# Nightly scheduler. Vercel sends this value as the cron Authorization bearer token.
CRON_SECRET=replace-with-a-separate-random-secret

# Outbound email addresses must be allowed by Resend.
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=crfrary@gmail.com
# Optional separate sender for employee schedules, staff messages, and attendance alerts. Falls back to ALERT_FROM_EMAIL.
EMPLOYEE_NOTIFICATION_FROM_EMAIL=
# Optional direct Employee Hub base URL. Falls back to APP_URL.
EMPLOYEE_APP_URL=

# Optional Telnyx SMS schedule notifications.
# Use a 10DLC-registered U.S. number and record employee consent in Employees before enabling SMS.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# Ogdensburg weather coordinates. Open-Meteo does not require an API key for this proof of concept.
WEATHER_LATITUDE=44.6942
WEATHER_LONGITUDE=-75.4863

# Plaid connects every checking, savings, and credit-card issuer authorized for each business.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Google Drive receipt folders and Google Document AI expense OCR.
# Create one Google Cloud service account, enable Drive API and Document AI API,
# then share each receipt folder with GOOGLE_SERVICE_ACCOUNT_EMAIL as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Preserve the private-key newlines or store them as escaped \n characters.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_EXPENSE_PROCESSOR_ID=
GOOGLE_DRIVE_RECEIPTS_FOLDER_CORNER_DELI=
GOOGLE_DRIVE_RECEIPTS_FOLDER_TIKI=

# Square supplies Tiki payments, orders, catalog, inventory, and tips.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENV=sandbox
SQUARE_API_VERSION=2026-07-15
# Copy the Webhook Signature Key from the Square Developer dashboard.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the HTTPS URL registered in Square, including /api/square/webhook.
SQUARE_WEBHOOK_NOTIFICATION_URL=
