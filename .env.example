# Created automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=

# Optional for local Blob access. Vercel deployments use automatic OIDC credentials.
BLOB_READ_WRITE_TOKEN=

# Single-owner login for the current milestone.
APP_EMAIL=crfrary@gmail.com
APP_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: enables the Google Apps Script Rezku Gmail bridge.
REZKU_INGEST_SECRET=replace-with-a-separate-random-secret
