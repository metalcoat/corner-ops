# Core application
DATABASE_DRIVER=neon
DATABASE_URL=
STORAGE_DRIVER=vercel
LOCAL_STORAGE_PATH=/data/uploads
HEALTHCHECK_DATABASE=false
SESSION_SECRET=
# Optional purpose-specific keys; each one unset is derived from SESSION_SECRET (production leaves them unset).
OWNER_SESSION_SECRET=
EMPLOYEE_SESSION_SECRET=
DELI_BOARD_SESSION_SECRET=
EMPLOYEE_PIN_PEPPER=
INTEGRATION_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY=
# production restricts the proxy to the public ops/team hosts
APP_ENV=
APP_PASSWORD=
APP_EMAIL=
APP_URL=
# Optional. When unset, authentication cookies are Secure unless APP_URL explicitly uses http://.
COOKIE_SECURE=
# Server-only delivery address services. Store coordinates are configuration, never guessed.
ADDRESS_PROVIDER=
GOOGLE_MAPS_API_KEY=
DELI_ORIGIN_LATITUDE=
DELI_ORIGIN_LONGITUDE=
DELI_DELIVERY_RADIUS_MILES=12
# Generated by Vercel when a Blob store is connected to this project. Do not invent this value.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Dharma / Priority MX Merchant: all card payments (server-only).
# MX_ENVIRONMENT=production uses the live account; anything else uses the sandbox.
MX_ENVIRONMENT=sandbox
VOICE_PAYMENT_DEBUG_RECOGNITION=false
MX_MERCHANT_ID=
MX_CONSUMER_KEY=
MX_CONSUMER_SECRET=
MX_BUSINESS_ID=
MX_TERMINAL_API_ENABLED=false

# Employment forms and direct deposit encryption
EMPLOYMENT_FORMS_ENCRYPTION_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=https://corner-ops.vercel.app/ops/integrations
# Optional Plaid Dashboard Link customization configured for Account Select = Multiple or All.
PLAID_LINK_CUSTOMIZATION_NAME=

# Azure Document Intelligence invoice/receipt OCR
# Create an Azure AI Document Intelligence resource on the F0 tier, then copy its endpoint and key.
INVOICE_OCR_PROVIDER=azure
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# Optional upload-only scanner PINs for vendors, contractors, or other non-employees.
# Employees use their normal Employee Hub session and owners use their owner session.
DOCUMENT_UPLOAD_PIN_CORNER_DELI=
DOCUMENT_UPLOAD_PIN_TIKI=

# Square
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
SQUARE_REDIRECT_URI=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_VERSION=2026-07-15

# Resend / alerts
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CUSTOMER_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CUSTOMER_APP_URL=https://dev.ordercornerdeli.com
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_ORDERING_MCP_URL=
OPENAI_ORDERING_MCP_TOKEN=
OPENAI_PHONE_TEST_DIDS=
OPENAI_PHONE_DID_LINES=
OPENAI_PHONE_HANDOFF_TARGET=
OPENAI_PHONE_ORDERING_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
GEMINI_API_KEY=
GEMINI_PHONE_BRIDGE_ENABLED=false
ASTERISK_3CX_IP=192.168.1.46
ASTERISK_OPENAI_PROJECT_ID=
ASTERISK_OPENAI_DID=+13156057291
REZKU_ALLOWED_SENDER=support@rezku.com
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
EMPLOYEE_NOTIFICATION_FROM_EMAIL=

# Employee portal, onboarding SMS, and schedule SMS
# SMS is sent only to employees whose consent has been recorded in Corner Ops.
EMPLOYEE_APP_URL=https://corner-ops.vercel.app
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=

# Push notifications
PUSH_SUBJECT=mailto:crfrary@gmail.com

# Weather
OPENWEATHER_API_KEY=

# 3CX CDR inbound and Deli missed-call analysis
# Use the same long random secret in the external CDR receiver as CORNER_OPS_CDR_SECRET.
THREE_CX_CDR_SECRET=
THREE_CX_CRM_SECRET=
THREE_CX_DELI_QUEUE=90
# Comma-separated Deli extension numbers
THREE_CX_DELI_EXTENSIONS=95,96
THREE_CX_IGNORE_SECONDS=4
THREE_CX_ISSUE_SECONDS=30
# Backups (deploy/backup-db.sh). Optional rclone remote for an off-site copy, e.g. gdrive-crypt:corner-ops-backups
CORNER_OPS_BACKUP_KEEP_DAYS=30
CORNER_OPS_BACKUP_RCLONE_REMOTE=
# Delivery maps: store address (geocoded once) and optional map tile URL
DELI_ORIGIN_ADDRESS=828 Morris St, Ogdensburg, NY 13669
MAP_TILE_URL=

# Supplier website prices (deploy/supplier-scraper). The deli's own logins for
# each ordering site; leave blank to skip a supplier. A password is optional
# (US Foods signs in with a username and a code sent by email or text).
# Sign-in codes are read from the inbox below if set, or typed in on Supplier
# costs. *_CODE_VIA=email|text picks where the code goes. *_ORDER_GUIDE_URL
# overrides the default order guide page(s) if a site moves them; list several
# pages separated by spaces to read them all (e.g. order guide + recently purchased).
# Inbox the codes go to (Gmail: imap.gmail.com with an app password):
CODE_EMAIL_HOST=
CODE_EMAIL_USER=
CODE_EMAIL_PASSWORD=
USFOODS_CODE_VIA=email
SYSCO_USERNAME=
SYSCO_PASSWORD=
SYSCO_CODE=
SYSCO_ORDER_GUIDE_URL=
USFOODS_USERNAME=
USFOODS_PASSWORD=
USFOODS_CODE=
USFOODS_ORDER_GUIDE_URL=
PFG_USERNAME=
PFG_PASSWORD=
PFG_CODE=
PFG_ORDER_GUIDE_URL=
