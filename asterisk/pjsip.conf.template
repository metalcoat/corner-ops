[global]
type=global
user_agent=Corner-Ops-Asterisk

[transport-3cx-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-openai-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
method=tlsv1_2
verify_server=yes
allow_wildcard_certs=yes
require_client_cert=no
ca_list_file=/etc/ssl/certs/ca-certificates.crt

[three-cx]
type=endpoint
transport=transport-3cx-udp
context=from-three-cx
aors=three-cx
disallow=all
allow=ulaw
allow=alaw
direct_media=no
media_encryption=sdes
media_encryption_optimistic=yes
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
dtmf_mode=rfc4733

[three-cx]
type=aor
contact=sip:${ASTERISK_3CX_IP}:5060

[three-cx-identify]
type=identify
endpoint=three-cx
match=${ASTERISK_3CX_IP}

[openai]
type=endpoint
transport=transport-openai-tls
aors=openai
context=from-openai
disallow=all
allow=ulaw
allow=alaw
direct_media=no
media_encryption=sdes
dtmf_mode=rfc4733
from_domain=sip.api.openai.com

[openai]
type=aor
contact=sip:sip.api.openai.com:5061;transport=tls

[openai-identify]
type=identify
endpoint=openai
match=sip.api.openai.com
