[general]
static=yes
writeprotect=yes
clearglobalvars=no

[from-three-cx]
exten => h,1,Hangup()
exten => ${ASTERISK_VOICE_PAYMENT_EXTENSION},1,NoOp(Isolated local sandbox voice payment)
 same => n,Answer()
 same => n,Set(EAGI_AUDIO_FORMAT=slin16)
 same => n,EAGI(/usr/local/bin/corner-ops-voice-payment)
 same => n,GotoIf($["${VOICE_PAYMENT_RESULT}"="approved"]?done)
 same => n,Dial(PJSIP/${ASTERISK_VOICE_PAYMENT_FALLBACK_EXTENSION}@three-cx,45)
 same => n(done),Hangup()
exten => _.,1,NoOp(Bridging 3CX call ${CALLERID(num)} to OpenAI Realtime SIP)
 same => n,Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,P-Asserted-Identity)})
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,Remote-Party-ID)}))
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,From)}))
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${CALLERID(num)}))
 same => n,Set(AI_CALLER=${URIENCODE(${CORNER_CALLER_IDENTITY})})
 same => n,Set(CURLOPT(httpheader)=x-voice-payment-secret: ${ENV(VOICE_PAYMENT_INTERNAL_SECRET)})
 same => n,Set(AI_ROUTE=${CURL(http://127.0.0.1:3000/api/internal/ai-phone?caller=${AI_CALLER}&did=${ASTERISK_OPENAI_DID})})
 same => n,Set(AI_PROVIDER=${CUT(AI_ROUTE,|,1)})
 same => n,Set(AI_CALL_ID=${CUT(AI_ROUTE,|,2)})
 same => n,GotoIf($["${AI_PROVIDER}"="gemini" & ${LEN(${AI_CALL_ID})}=36]?gemini)
 same => n,Dial(${PJSIP_DIAL_CONTACTS(openai,openai,${ASTERISK_OPENAI_PROJECT_ID})},60,b(add-openai-headers^s^1))
 same => n,Hangup()
 same => n(gemini),NoOp(Bridging call to Gemini Live ${AI_CALL_ID})
 same => n,Answer()
 same => n,TryExec(AudioSocket(${AI_CALL_ID},127.0.0.1:9092))
 same => n,Set(GEMINI_RESULT=${CURL(http://127.0.0.1:3000/api/internal/ai-phone?action=status&callId=${AI_CALL_ID})})
 same => n,GotoIf($["${GEMINI_RESULT}"="payment"]?gemini-payment)
 same => n,GotoIf($["${GEMINI_RESULT}"="handoff"]?gemini-handoff)
 same => n,Hangup()
 same => n(gemini-payment),Set(EAGI_AUDIO_FORMAT=slin16)
 same => n,EAGI(/usr/local/bin/corner-ops-voice-payment)
 same => n,GotoIf($["${VOICE_PAYMENT_RESULT}"="approved"]?done)
 same => n,Dial(PJSIP/${ASTERISK_VOICE_PAYMENT_FALLBACK_EXTENSION}@three-cx,45)
 same => n,Goto(done)
 same => n(gemini-handoff),Dial(PJSIP/${ASTERISK_VOICE_PAYMENT_FALLBACK_EXTENSION}@three-cx,45)
 same => n(done),Hangup()

[add-openai-headers]
exten => s,1,Set(PJSIP_HEADER(add,X-Corner-Ops-DID)=${ASTERISK_OPENAI_DID})
 same => n,Set(PJSIP_HEADER(add,P-Called-Party-ID)=<sip:${ASTERISK_OPENAI_DID}>)
 same => n,Set(PJSIP_HEADER(add,X-Corner-Ops-Caller)=${CORNER_CALLER_IDENTITY})
 same => n,Return()

[from-openai]
exten => _X!,1,Hangup()
