[general]
static=yes
writeprotect=yes
clearglobalvars=no

[from-three-cx]
exten => h,1,Hangup()
exten => ${ASTERISK_VOICE_PAYMENT_EXTENSION},1,NoOp(Isolated local sandbox voice payment)
 same => n,Answer()
 same => n,Set(EAGI_AUDIO_FORMAT=slin16)
 same => n,EAGI(/usr/local/bin/corner-ops-voice-payment)
 same => n,GotoIf($["${VOICE_PAYMENT_RESULT}"="approved"]?done)
 same => n,Dial(PJSIP/${ASTERISK_VOICE_PAYMENT_FALLBACK_EXTENSION}@three-cx,45)
 same => n(done),Hangup()
exten => _.,1,NoOp(Bridging 3CX call ${CALLERID(num)} to OpenAI Realtime SIP)
 same => n,Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,P-Asserted-Identity)})
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,Remote-Party-ID)}))
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${PJSIP_HEADER(read,From)}))
 same => n,ExecIf($[${LEN(${CORNER_CALLER_IDENTITY})}=0]?Set(__CORNER_CALLER_IDENTITY=${CALLERID(num)}))
 same => n,Dial(${PJSIP_DIAL_CONTACTS(openai,openai,${ASTERISK_OPENAI_PROJECT_ID})},60,b(add-openai-headers^s^1))
 same => n,Hangup()

[add-openai-headers]
exten => s,1,Set(PJSIP_HEADER(add,X-Corner-Ops-DID)=${ASTERISK_OPENAI_DID})
 same => n,Set(PJSIP_HEADER(add,P-Called-Party-ID)=<sip:${ASTERISK_OPENAI_DID}>)
 same => n,Set(PJSIP_HEADER(add,X-Corner-Ops-Caller)=${CORNER_CALLER_IDENTITY})
 same => n,Return()

[from-openai]
exten => _X!,1,Hangup()
