{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "agent/rebuild-corner-ops": false,
      "agent/vercel-cost-stabilization": false,
      "agent/full-codebase-review-remediation": false,
      "agent/codebase-review-stage-2": false,
      "agent/codebase-review-stage-3": false,
      "agent/codebase-review-stage-4": false,
      "agent/rezku-reliability-hotfix": false,
      "agent/codebase-review-stage-5-runtime": false,
      "agent/codebase-review-stage-6": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/scheduler-0700",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scheduler-0800",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rezku-repair",
      "schedule": "*/15 * * * *"
    }
  ]
}
